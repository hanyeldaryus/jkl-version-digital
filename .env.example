# Lokal: salin file ini menjadi .env.
# Produksi Vercel: masukkan nilai-nilai ini di Project Settings > Environment Variables.
APP_ENV=production
SECRET_KEY=
ENCRYPTION_KEY=
# PostgreSQL wajib untuk deployment Vercel. Contoh:
# postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=
# Untuk Vercel, memory:// aman untuk rate limit sederhana per instance.
# Jika memakai Redis/Upstash, ganti dengan URL Redis.
RATELIMIT_STORAGE_URI=memory://
TRUST_PROXY=1
